  <style>
    * { box-sizing: border-box; font-family: 'Inter', sans-serif; }
    body { background-color: #030407; color: #ffffff; overflow-x: hidden; margin: 0; }
    
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #030407; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #00d2ff; }

    /* Hiệu ứng con trỏ gõ chữ */
    .cursor-blink {
      display: inline-block;
      width: 2px;
      height: 1.1em;
      background-color: #00d2ff;
      vertical-align: middle;
      margin-left: 4px;
      animation: blink 0.8s infinite;
    }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* 3D Flip Card cho thẻ ID */
    .perspective-1000 { perspective: 1200px; }
    .preserve-3d { transform-style: preserve-3d; transition: transform 0.7s cubic-bezier(0.23, 1, 0.32, 1); }
    .backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }

    /* Hiệu ứng kính lúp X-Ray phần About Me */
    .xray-container {
      position: relative;
      user-select: none;
      cursor: crosshair;
    }
    .xray-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      clip-path: circle(0px at 50% 50%);
      transition: clip-path 0.08s ease-out;
    }
    .xray-ring {
      position: absolute;
      width: 150px;
      height: 150px;
      border-radius: 50%;
      border: 1.5px solid rgba(0, 210, 255, 0.5);
      box-shadow: 0 0 25px rgba(0, 210, 255, 0.25), inset 0 0 15px rgba(0, 210, 255, 0.15);
      pointer-events: none;
      transform: translate(-50%, -50%);
      opacity: 0;
      transition: opacity 0.2s;
    }
  </style>
</head>
